# Production settings for docker-compose.prod.yml.
# Copy to .env.production on the server and fill in every value.
# Generate secrets with:  openssl rand -hex 32

# --- Public addresses ---
# The API's domain (no https://). With no domain of your own, use the
# server's IP with dashes + .sslip.io, e.g. 129-146-12-34.sslip.io
API_DOMAIN=
# The Vercel site, e.g. https://untold-money.vercel.app
FRONTEND_URL=
# The site forwards /api/v1/* here, so broker sign-ins come back through it.
# Same value as FRONTEND_URL.
API_PUBLIC_URL=
# The site's address; the live price WebSocket checks it.
BACKEND_CORS_ORIGINS=["https://your-site.vercel.app"]

# --- App ---
APP_NAME=UntoldMoney
API_VERSION=v1
LOG_LEVEL=INFO

# --- Database (lives on the server) ---
POSTGRES_USER=untoldmoney
POSTGRES_PASSWORD=
POSTGRES_DB=untoldmoney

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Brokers ---
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_TOKEN_KEY=
# The server's public IP (Angel One asks for it)
BROKER_EGRESS_IP=
ANGELONE_API_KEY=
FYERS_APP_ID=
FYERS_SECRET_ID=

# --- Log viewer (Dozzle) at https://LOGS_DOMAIN ---
# e.g. logs.129-146-12-34.sslip.io. Hash the password with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
LOGS_DOMAIN=
LOGS_USER=admin
LOGS_PASSWORD_HASH=''

# --- AI agent tools at /mcp (leave empty to keep them off) ---
MCP_API_KEY=
