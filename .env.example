# ===========================================
# UntoldMoney — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ===========================================

# --- Application ---
APP_ENV=local
APP_NAME=untoldmoney
API_VERSION=v1
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=untoldmoney
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=untoldmoney
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- JWT ---
JWT_SECRET_KEY=changeme_super_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Celery ---
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# --- Rate Limiting (future) ---
# RATE_LIMIT_PER_MINUTE=60

# --- Data Providers (future) ---
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=
# YAHOO_FINANCE_ENABLED=true

# --- ML/AI (future) ---
# OPENAI_API_KEY=
# MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Email/Notifications (future) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
