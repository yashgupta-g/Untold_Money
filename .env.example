# ===========================================
# UntoldMoney — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ===========================================

# --- Application ---
APP_ENV=local
APP_NAME=UntoldMoney
API_VERSION=v1
DEBUG=true
LOG_LEVEL=INFO

# --- Secrets Manager (staging/production) ---
# When set, settings are loaded from this AWS Secrets Manager secret and
# override env vars / .env. The secret must be a JSON object keyed by setting
# name, e.g. {"POSTGRES_PASSWORD": "...", "JWT_SECRET_KEY": "..."}.
# Credentials come from the IAM role (or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
# Leave unset for local development.
# AWS_SECRETS_MANAGER_SECRET_ID=untoldmoney/production
# AWS_REGION=ap-south-1

# --- Database (PostgreSQL) ---
POSTGRES_USER=untoldmoney
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=untoldmoney
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL is auto-assembled from the above components.
# Set it explicitly only if you need a custom connection string:
# DATABASE_URL=postgresql+asyncpg://untoldmoney:changeme_postgres_password@localhost:5432/untoldmoney

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL is auto-assembled from the above components.

# --- JWT ---
# IMPORTANT: Change these in any non-local environment!
JWT_SECRET_KEY=changeme_super_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# JSON array of allowed origins. Docker Compose overrides these for container networking.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Rate Limiting (future) ---
# RATE_LIMIT_PER_MINUTE=60

# --- Data Providers (future) ---
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=
# YAHOO_FINANCE_ENABLED=true

# --- ML/AI (future) ---
# OPENAI_API_KEY=
# MLFLOW_TRACKING_URI=http://mlflow:5000

# --- Email/Notifications (future) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SENDGRID_API_KEY=
